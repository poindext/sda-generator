      {
        "analyte": "HDL Cholesterol",
        "field": "abnormal_min",
        "operator": ">=",
        "value": 15,
        "unit": "mg/dL"
      },
      {
        "analyte": "Calcium",
        "field": "abnormal_max",
        "operator": "<=",
        "value": 12.0,
        "unit": "mg/dL"
      }
    ]
  },

