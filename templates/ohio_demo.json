  "cohort_descriptions": {
    "hypertension": "Patient with essential hypertension. Include 1 outpatient encounter and 1-2 antihypertensive medications. Include a blood pressure observation showing elevated readings. No diabetes or other chronic conditions.",

    "diabetes_controlled": "Patient with type 2 diabetes, reasonably controlled (A1c between 7.0-8.9%). Include 1-2 outpatient encounters, metformin and/or one other diabetes medication, and an A1c lab result within the past 6 months.",

    "diabetes_poor_control": "Patient with poorly controlled type 2 diabetes. A1c must be above 9.0%. Include 1-2 outpatient encounters, current diabetes medications, and an A1c lab result clearly showing A1c >= 9.1%. This patient represents the 15-20% of the state diabetes cohort with poor glycemic control.",

    "diabetes_no_recent_a1c": "Patient with type 2 diabetes on metformin. The last encounter was 8-10 months ago. Include glucose results from that encounter but NO A1c result at all — the patient has not had an A1c measured in over 6 months. This represents the 20-25% monitoring gap cohort that the HIE needs to identify.",

    "asthma": "Patient with asthma. Include 1 outpatient encounter and optionally 1 ED encounter if an exacerbation is clinically appropriate. Medications: rescue inhaler (albuterol) required; controller inhaler (fluticasone or combination) optional.",

    "cardiovascular_disease": "Patient with cardiovascular disease (coronary artery disease, prior MI, or heart failure). Include 1-2 encounters, appropriate cardiac medications (statin, aspirin, beta-blocker, ACE inhibitor or ARB), and a lipid panel lab result.",

    "multiple_chronic": "Patient with 2-3 chronic conditions chosen from: type 2 diabetes, hypertension, asthma, obesity, COPD. Include 2 outpatient encounters spread across the past 18 months and appropriate medications for each condition. Include at least one relevant lab result.",

    "pregnancy": "Pregnant patient at a prenatal visit. Include 1-2 prenatal outpatient encounters with appropriate supervision-of-pregnancy diagnoses (Z34.x). Include at least one prenatal lab (blood type, CBC, or glucose screen). Age must be 18-45.",

    "healthy": "Generally healthy patient — new registration or annual wellness visit. Include 1 outpatient encounter with normal vital signs. No chronic diagnoses or medications required. May include basic wellness labs (CBC, lipids) if clinically appropriate for the patient's age."
  },

  "sending_facility": "Ohio Health Information Partnership",

  "extra_instructions": "Use realistic Ohio facility names appropriate to the county setting. Rural counties should use critical access hospitals or federally qualified health centers. Urban counties may use academic medical centers or large community hospitals."
}
