<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS HttpPlatformHandler configuration.
  Requires: IIS HttpPlatformHandler module installed.

  Steps:
    1. Install Python 3.11+ on the server.
    2. pip install -r app_requirements.txt
    3. Set OPENAI_API_KEY below (or inject via IIS environment variables / App Settings).
    4. Update processPath to your Python installation path.
    5. Create an IIS Application pointing to this directory.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
      processPath="%SystemDrive%\Python311\python.exe"
      arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\iis-stdout.log"
      startupTimeLimit="60"
      requestTimeout="00:30:00">

      <environmentVariables>
        <!-- Set your OpenAI API key here or via IIS App Settings / Windows env -->
        <environmentVariable name="OPENAI_API_KEY" value="" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Sub-path deployment: set to the IIS Application path, e.g. /genesis -->
        <!-- Leave empty (or remove) for root deployment -->
        <environmentVariable name="GENESIS_ROOT_PATH" value="/genesis" />
      </environmentVariables>
    </httpPlatform>

    <!-- Allow long-running SSE connections (generation can take many minutes) -->
    <serverRuntime uploadReadAheadSize="0" />
  </system.webServer>
</configuration>
